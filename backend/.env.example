##############################################################
# WARNING: CHANGE ALL SECRETS BEFORE DEPLOYING TO PRODUCTION
#
# The values below are EXAMPLE DEFAULTS for local development.
# They are intentionally simple and publicly known.
# Using these defaults in production is a SECURITY RISK.
#
# Secrets to change before going live:
#   POSTGRES_PASSWORD   — use a strong random password
#   HASURA_ADMIN_SECRET — minimum 32 chars, use openssl rand -hex 32
#   AUTH_JWT_SECRET     — must be 64+ chars, use openssl rand -hex 64
#   S3_ACCESS_KEY       — change from default "minioaccesskey"
#   S3_SECRET_KEY       — change from default "miniosecretkey"
#   REDIS_PASSWORD      — use openssl rand -hex 32
##############################################################

###############################################################################
# nSelf Backend Environment Variables
#
# Copy this file to .env.dev and customize the values.
#
#   cp backend/.env.example backend/.env.dev
#
# IMPORTANT: Never commit .env.dev to version control!
###############################################################################

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_USER=postgres
# WARNING: Change before production — never use "postgres" as a real password
# nself build rejects anything under 16 characters. Replace before any real use:
#   openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE-ME-local-dev-only-0123456789
POSTGRES_DB=ntask
POSTGRES_PORT=5432

# ── consumed by `nself build` (CLI-templated), not read by app code ──
# The vars in this section configure the nself CLI's docker-compose /
# nginx / Hasura-metadata generation templates. App code (functions/,
# plugins) never reads these directly at runtime — the app-read
# equivalents (HASURA_GRAPHQL_URL, HASURA_GRAPHQL_ADMIN_SECRET, etc.)
# are documented separately below under "App-Read Runtime Vars".
# Kept here (not deleted) because `nself build` still consumes them
# when regenerating the stack. See PCI: compose-secret-templating for
# the known gap where some of these knobs are silently ignored.

# =============================================================================
# Hasura GraphQL Engine
# =============================================================================
HASURA_PORT=8080

# REQUIRED: Change before production — generate with: openssl rand -hex 32
# nself build rejects anything under 32 characters. Replace before any real use:
#   openssl rand -hex 32
HASURA_ADMIN_SECRET=CHANGE-ME-local-dev-only-0123456789012345678901234567890123

# =============================================================================
# Authentication (Hasura Auth)
# =============================================================================
# AUTH_PORT is the SINGLE source of truth for the auth service port. Compose
# publishes it, and the backend functions derive their auth base URL from it
# (functions/lib/auth-service.ts). Do not hardcode the port anywhere else.
#
# NEVER SET THIS TO 4001. nhost/hasura-auth 0.36.0 is a Go front-end that serves
# some routes itself and reverse-proxies the rest to a bundled Node server on a
# fixed internal port of 4001. With AUTH_PORT=4001 the Go server binds 4001 and
# then proxies to itself, so every proxied route (/signout, /user/mfa,
# /mfa/totp/generate) answers 502 and the log fills with
# "proxy error: readfrom tcp [::1]:*->[::1]:4001: unexpected EOF".
# Verified 2026-08-16 against the running image; a sibling stack on AUTH_PORT=4000
# proxies correctly to the same Node server.
#
# If 4000 is taken on a shared dev machine, use 4010 (or any free port that is
# NOT 4001) and set HASURA_AUTH_URL to match — see below.
AUTH_PORT=4000

# REQUIRED: Change before production — must be 64+ chars
# Generate with: openssl rand -hex 64
AUTH_JWT_SECRET=replace-me-with-at-least-64-random-chars-use-openssl-rand-hex-64

# Where the auth service is reachable from the outside.
# AUTH_MODE=bundled (default): this URL is served by THIS stack's nginx + TLS.
#   dev:     http://localhost:4000   (direct, no nginx TLS for dev)
#   staging: https://auth.staging.nself.org   (Traefik TLS — this stack)
#   prod:    https://auth.nself.org           (Traefik TLS — this stack)
# AUTH_MODE=external: set to the external shared auth URL and skip the auth container.
AUTH_SERVER_URL=http://localhost:4000

# Where the frontend app lives (for redirects after email verification, etc.)
# Local:      http://localhost:3000
# Staging:    https://task.staging.nself.org
# Production: https://task.nself.org
AUTH_CLIENT_URL=http://localhost:3000

# Token expiration (seconds)
AUTH_ACCESS_TOKEN_EXPIRES_IN=900
AUTH_REFRESH_TOKEN_EXPIRES_IN=43200

# Auth features
AUTH_EMAIL_PASSWORDLESS_ENABLED=false
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_ANONYMOUS_USERS_ENABLED=false
AUTH_DISABLE_NEW_USERS=false
AUTH_LOCALE_DEFAULT=en
AUTH_GRAVATAR_ENABLED=true

# =============================================================================
# Storage (Hasura Storage + MinIO)
# =============================================================================
STORAGE_PORT=8484
STORAGE_PUBLIC_URL=http://localhost:8484

# MinIO (S3-compatible object storage)
#
# REQUIRED for attachments. Without this flag `nself build` generates no MinIO
# service at all, so getUploadUrl has nothing to sign against and file
# attachments silently do not work. The other MINIO_* values below are not
# enough on their own - the generator gates the whole service on this one var.
MINIO_ENABLED=true
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# WARNING: Change before production
S3_ACCESS_KEY=minioaccesskey
# CHANGE: Strong key — generate with: openssl rand -hex 32
MINIO_ACCESS_KEY=minioaccesskey
# WARNING: Change before production
S3_SECRET_KEY=miniosecretkey
# CHANGE: Strong secret — generate with: openssl rand -hex 32
MINIO_SECRET_KEY=miniosecretkey
S3_ENDPOINT=http://minio:9000
# Internal (Docker network) MinIO endpoint — used by functions service
MINIO_ENDPOINT=http://minio:9000
# Public MinIO endpoint — used for presigned download URLs returned to clients
# CHANGE: Set to publicly accessible MinIO URL (or CDN) for staging/prod
MINIO_ENDPOINT_PUBLIC=http://localhost:9000
S3_BUCKET=nhost
MINIO_BUCKET=ntask

# hasura-auth internal URL, used by functions/account-ops.ts (email/password/MFA)
# and collab-ops.ts (invite mail relay).
# Leave it at the derived default when auth runs in this stack: the handlers build
# http://auth:${AUTH_PORT} themselves, so there is one port to change, not two.
# Account deletion and session listing/revocation no longer use HTTP at all —
# hasura-auth 0.36.0 has no DELETE /users/{id} and no /user/sessions routes, so
# those go through the admin GraphQL path (auth.users / auth.refresh_tokens).
HASURA_AUTH_URL=http://auth:4000
# ── end CLI-templated section (Hasura/Auth/Storage infra above) ──

# AWS/S3 region string required by the MinIO S3 SDK client (storage-presign.ts).
# CHANGE: Match your MinIO/S3 region if not using the default.
MINIO_REGION=us-east-1

# =============================================================================
# App-Read Runtime Vars (consumed directly by app code, not the CLI templater)
# =============================================================================
# Read by backend/functions code at runtime — these are NOT nself-build knobs.

# Hasura GraphQL endpoint used by functions/scripts to run queries directly.
# Local:      http://hasura:8080/v1/graphql (Docker internal) or http://localhost:8080/v1/graphql
# Staging:    https://api.task.staging.nself.org/v1/graphql
# Production: https://api.task.nself.org/v1/graphql
HASURA_GRAPHQL_URL=http://hasura:8080/v1/graphql

# Admin secret used by functions to make privileged Hasura calls.
# NOTE: generated into backend/.env.secrets by `nself init`/`nself build` —
# do not hand-set in production; this placeholder is for local dev only.
# CHANGE: Match the value nself generates in .env.secrets.
HASURA_GRAPHQL_ADMIN_SECRET=CHANGE-ME-local-dev-only-0123456789012345678901234567890123

# Public base URL of the frontend app — used to build links in outbound
# collab-invite emails (backend/functions/collab-ops.ts).
# Local:      http://localhost:3000
# Staging:    https://task.staging.nself.org
# Production: https://task.nself.org
NTASK_APP_BASE_URL=http://localhost:3000

# "From" address for outbound transactional email (collab-ops.ts). Distinct
# from the hasura-auth SMTP vars below — this one is read directly by the
# functions service. Must match SPF-authorized domain in production.
SMTP_FROM_ADDRESS=no-reply@task.local.nself.org

# Postgres connection string used by every free plugin's DB client and by
# backup/restore scripts (backend/scripts/backup-remote.sh, restore-remote.sh,
# Makefile dr-test target). Keep in sync with the POSTGRES_* vars above.
# Local:      postgresql://postgres:postgres@localhost:5432/ntask
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ntask

# Shared secret free plugins use to authenticate internal service-to-service
# calls (tokens, webhooks, notify, etc. plugin containers). Generated into
# backend/.env.secrets by `nself init` — do not hand-set in production.
# CHANGE: Match the value nself generates in .env.secrets.
PLUGIN_INTERNAL_SECRET=replace-me-generated-by-nself-init

# Symmetric key the `tokens` free plugin uses to encrypt stored OAuth/API
# tokens at rest. Generate with: openssl rand -hex 32
# CHANGE: Never reuse across environments; rotate = re-encrypt existing rows.
TOKENS_ENCRYPTION_KEY=replace-me-with-openssl-rand-hex-32

# HMAC key the `webhooks` free plugin uses to sign outbound webhook payloads
# so receivers can verify authenticity. Generate with: openssl rand -hex 32
WEBHOOK_HMAC_SECRET=replace-me-with-openssl-rand-hex-32

# Set to 1 to force `make seed-prod` to run against a production-flagged
# environment (guards against accidental prod seeding). Leave 0 normally.
# See backend/scripts/seed-prod.sh.
FORCE_PROD_SEED=0

# Password for the initial nSelf owner/admin account seeded by seed-prod.sh /
# seed-dev.sh. Source from ~/.claude/vault.env for staging/prod — never commit
# a real value. CHANGE before any non-local seed run.
NSELF_OWNER_PASSWORD=changeme-local-dev-only

# Project name nself scripts use to scope container/network names and to
# select the right .env.<env> file (seed-prod.sh, seed-dev.sh). Must match
# the `app:` name in backend/nself.yaml.
# PROJECT_NAME is the variable the nSelf CLI actually reads. It names every
# container, the docker network and the compose project, so with it unset the
# stack comes up as myproject_* and every documented command (docker exec
# ntask_postgres, the backup scripts, metadata-diff) addresses containers that
# do not exist. NSELF_PROJECT_NAME is kept only for older tooling; `nself build`
# logs it as an unknown variable and ignores it.
# The domain every generated vhost and certificate is issued for, and the value
# scripts/seed-dev.sh checks before it will seed anything. With it unset the dev
# seed refuses ("BASE_DOMAIN='' is not local/staging") and a fresh install ends
# with no test accounts, which reads as a broken install rather than a missing
# variable.
BASE_DOMAIN=task.local.nself.org
PROJECT_NAME=ntask
NSELF_# The domain every generated vhost and certificate is issued for, and the value
# scripts/seed-dev.sh checks before it will seed anything. With it unset the dev
# seed refuses ("BASE_DOMAIN='' is not local/staging") and a fresh install ends
# with no test accounts, which reads as a broken install rather than a missing
# variable.
BASE_DOMAIN=task.local.nself.org
PROJECT_NAME=ntask

# Fallback auth server URL read by backend/scripts/seed.ts when AUTH_SERVER_URL
# is unset. Normally leave unset — AUTH_SERVER_URL above takes precedence.
# NSELF_AUTH_URL=http://localhost:4000

# Standard Node.js environment flag. Read by backend/functions/sentry.ts to
# pick the reported Sentry environment (defaults to "production" if unset —
# set to "development" for local dev so errors aren't tagged as prod).
NODE_ENV=development

# ── consumed by `nself build` (CLI-templated), not read by app code ──
# NAMING DRIFT WARNING: plugins (and hasura-auth) read SMTP_FROM /
# SMTP_PASSWORD-style vars from this section, while the app's own
# functions code reads the DIFFERENT pair SMTP_SENDER / SMTP_PASS below,
# and collab-ops.ts reads a THIRD var, SMTP_FROM_ADDRESS (documented
# above under "App-Read Runtime Vars"). Set ALL THREE pairs in sync:
#   Plugin/hasura-auth pair:  SMTP_HOST, SMTP_USER, SMTP_SENDER, SMTP_PASS, SMTP_SECURE
#   App-read pair:            SMTP_FROM_ADDRESS
# This drift is tracked; do not "clean up" one side without the other.

# =============================================================================
# Email (SMTP)
# =============================================================================
# Local development uses Mailhog (no real emails sent)
# For staging/production, configure a real SMTP provider.
# Recommended: Postmark (postmarkapp.com) — high transactional deliverability.
#
# J-S4-T1: SPF + DKIM + DMARC must be configured in Cloudflare DNS for nself.org
# before any production SMTP relay is used. See .github/docs/ops/email-deliverability.md
#
# `nself build` reads these SMTP_* values and emits AUTH_SMTP_* onto the auth
# container, which is what hasura-auth actually reads. For staging and production
# set the AUTH_SMTP_* block in the Transactional email section at the end of this
# file instead; those are the authoritative names.
# CHANGE: Replace mailhog values with relay credentials from ~/.claude/vault.env
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=no-reply@localhost
SMTP_SECURE=false


# hasura-auth custom email templates (J-S4-T2)
# NOTE: `AUTH_EMAIL_TEMPLATE_FETCH_URL` below is NOT a real hasura-auth 0.36.0
# flag/env var — verified against `nhost/hasura-auth:0.36.0 --help` and its
# source (go/notifications/templates.go). hasura-auth loads templates from a
# local filesystem path only, via AUTH_EMAIL_TEMPLATES_PATH (default
# /app/email-templates), expecting {locale}/{template-id}/{body.html,
# subject.txt}. There is no URL-fetch mechanism, so nothing should be set
# here. The path is mounted + pinned in docker-compose.override.yml (auth
# service) from backend/email-templates/ — not env-configurable per deploy.
# Left unset intentionally; do not resurrect the MinIO-URL approach below.
AUTH_EMAIL_TEMPLATE_FETCH_URL=

# hasura-auth email verification gate (J-S2-T1 change-email re-verification)
# Set to 'true' so new email must be verified before login with new address is allowed
HASURA_AUTH_EMAIL_SIGNIN_EMAIL_VERIFIED_REQUIRED=true

# =============================================================================
# Mailhog (Development Only)
# =============================================================================
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
# ── end CLI-templated section (Email/SMTP/Mailhog above) ──

# =============================================================================
# Staging / Production
# =============================================================================
# Uncomment and set these when deploying to a real domain.
# Traefik uses DOMAIN + ACME_EMAIL to obtain Let's Encrypt TLS certificates.
#
# nTask subdomain schema (DOMAIN=nself.org):
#   dev:     api.task.local.nself.org   (Hasura)   auth.local.nself.org   (auth — bundled or external)
#   staging: api.task.staging.nself.org (Hasura)   auth.staging.nself.org (auth — bundled or external)
#   prod:    api.task.nself.org         (Hasura)   auth.nself.org         (auth — bundled or external)
#
# Set DOMAIN=nself.org — Traefik labels in docker-compose.staging/production.yml
# use the api.task.{staging.}${DOMAIN} and storage.{staging.}${DOMAIN} patterns.

# DOMAIN=nself.org
# ACME_EMAIL=admin@nself.org

# =============================================================================
# Auth Mode
# =============================================================================
# AUTH_MODE=bundled  (default) — nTask runs hasura-auth in this stack.
#   Use for: local dev, self-hosted deploys, "nTask Bundle" scenarios.
#   auth.{domain} served by THIS stack's nginx → auth:4000 container.
#
# AUTH_MODE=external — no local auth container; JWT issued by external shared auth.
#   Use for: nself.org SaaS (auth.{env}.nself.org run by the central nSelf platform).
#   Set HASURA_AUTH_URL and SHARED_AUTH_SERVER_URL to the external auth endpoint.
#   Set SHARED_AUTH_JWT_SECRET to match the external auth's JWT secret.
#
# In BOTH modes, HASURA_GRAPHQL_JWT_SECRET must be env-templated (never hardcode).
# AUTH_MODE=bundled

# SHARED_AUTH_JWT_SECRET — JWT secret used by Hasura to validate tokens.
#   bundled:  must match secret generated by `nself init` (stored in .env.secrets)
#   external: must match the shared nself platform auth JWT secret
#   Format: {"type":"HS256","key":"<secret>"}  (or RS256 with JWKS URL)
#   Source: ~/.claude/vault.env → SHARED_AUTH_JWT_SECRET_DEV / _STAGING / _PROD
#   NEVER hardcode — always inject from .env.secrets or CI
# SHARED_AUTH_JWT_SECRET=

# SHARED_AUTH_SERVER_URL — base URL for the auth API (external mode only).
# Ignored in bundled mode (use AUTH_SERVER_URL above for the local container URL).
#   dev:     https://auth.local.nself.org
#   staging: https://auth.staging.nself.org
#   prod:    https://auth.nself.org
# SHARED_AUTH_SERVER_URL=https://auth.local.nself.org

# HASURA_AUTH_URL — used by functions/account-ops.ts and collab-ops.ts.
#   bundled:  derived as http://auth:${AUTH_PORT} when unset (preferred — one
#             source of truth, so code and compose cannot drift apart)
#   external: https://auth.{env}.nself.org
# HASURA_AUTH_URL=https://auth.staging.nself.org

# Redis password (uncomment when Redis is added to the compose stack)
# Generate with: openssl rand -hex 32
# REDIS_PASSWORD=

# =============================================================================
# OAuth Providers (Optional)
# =============================================================================
# Uncomment and configure the providers you want to use.
# You'll also need to enable them in the auth service configuration.

# AUTH_PROVIDER_GOOGLE_ENABLED=false
# AUTH_PROVIDER_GOOGLE_CLIENT_ID=
# AUTH_PROVIDER_GOOGLE_CLIENT_SECRET=

# AUTH_PROVIDER_GITHUB_ENABLED=false
# AUTH_PROVIDER_GITHUB_CLIENT_ID=
# AUTH_PROVIDER_GITHUB_CLIENT_SECRET=

# AUTH_PROVIDER_APPLE_ENABLED=false
# AUTH_PROVIDER_APPLE_CLIENT_ID=
# AUTH_PROVIDER_APPLE_KEY_ID=
# AUTH_PROVIDER_APPLE_PRIVATE_KEY=
# AUTH_PROVIDER_APPLE_TEAM_ID=

# =============================================================================
# Plugins
# =============================================================================
# ɳTask uses free plugins only — no license key required.
# Active free plugins: auth, storage, cron, notify, notifications, jobs,
#                      search, feature-flags, audit-log, webhooks,
#                      invitations, tokens
# Plugin list is declared in backend/nself.yaml (set by nself.yaml;
# listed here for reference only).
#
# To unlock Pro plugins, see: https://nself.org/pricing
# (No NSELF_PLUGIN_LICENSE_KEY needed for this app)

# ── consumed by `nself build` (CLI-templated), not read by app code ──
# KNOWN MISMATCH: the generated backend/nginx/includes/rate-limits.conf
# comment references RATE_LIMIT_API_RPS / RATE_LIMIT_AUTH_RPS /
# RATE_LIMIT_AI_RPS, but none of those (nor the *_RPM vars below) are
# actually templated into the zone rate= values — they're hardcoded in
# the generated conf. Changing the vars below currently has NO EFFECT.
# Tracked in PCI: compose-secret-templating.

# =============================================================================
# Rate Limiting (K-S2-T10)
# =============================================================================
# Configured in backend/nginx/includes/rate-limits.conf
# Override here to customize; nself build reads these vars.
RATE_LIMIT_AUTH_RPM=10
RATE_LIMIT_GRAPHQL_RPM=100
RATE_LIMIT_UPLOADS_RPM=5

# =============================================================================
# Demo Data
# =============================================================================
# Set to 1 and run `make demo-seed` to populate example tasks and lists.
# Never set to 1 on a production install with real data.
DEMO_SEED=0

# =============================================================================
# Hasura Production Hardening (K-S2-T08, K-S2-T11)
# =============================================================================
# Disable introspection + console in production (MUST be false in prod)
# Keep true for local dev. nself build sets these from env.
HASURA_GRAPHQL_ENABLE_CONSOLE=false
HASURA_GRAPHQL_DEV_MODE=false

# Disable telemetry (always off)
HASURA_GRAPHQL_ENABLE_TELEMETRY=false

# Enable query allow-list in prod (disable in dev for easy iteration)
# Set to true ONLY after all app operations are registered in query_collections.yaml
HASURA_GRAPHQL_ENABLE_ALLOWLIST=false

# Query complexity limits (set in prod; prevents nested-query DoS)
# Tune DEPTH_LIMIT to max(legitimate query depth) + 2. Default: 10
HASURA_GRAPHQL_DEPTH_LIMIT=10
HASURA_GRAPHQL_NODE_LIMIT=100
HASURA_GRAPHQL_BATCH_SIZE=10

# Subscription multiplexing (K-S4-T18)
HASURA_GRAPHQL_LIVE_QUERIES_MULTIPLEXED_REFETCH_INTERVAL=1000
HASURA_GRAPHQL_LIVE_QUERIES_MULTIPLEXED_BATCH_SIZE=100

# Unauthorized role (limit public role scope — see tables.yaml audit below)
HASURA_GRAPHQL_UNAUTHORIZED_ROLE=public
# ── end CLI-templated section (Rate Limiting/Hasura hardening above) ──

# =============================================================================
# Functions / Event Trigger Handler
# =============================================================================
# URL where Hasura sends Action, event trigger, and cron trigger webhook calls.
# This points at the functions service (backend/functions/server.ts).
#
# Docker (functions service on backend_network, enabled in nself.yaml):
#   ACTION_HANDLER_URL=http://functions:3001
#
# Local dev (run separately: cd backend/functions && pnpm dev):
#   ACTION_HANDLER_URL=http://host.docker.internal:3001
#
# CHANGE: Set to http://functions:3001 when running nself start (Docker mode).
# The functions service is declared in nself.yaml services.functions.
# Run `nself build` after enabling; Hasura action handler URLs resolve
# to http://functions:3001/api/actions/* inside the Docker bridge network.
#
# CLI gap: nself build does not yet auto-wire a custom entrypoint for the
# functions container. See PCI: nself-functions-service-entrypoint.
# Workaround: add FUNCTIONS_ENABLED=true + set PORT=3001 in nself.yaml.
ACTION_HANDLER_URL=http://functions:3001
FUNCTIONS_ENABLED=true
FUNCTIONS_PORT=3001

# Shared secret proving that a call to the functions service came from Hasura.
#
# WHY THIS MATTERS: every action handler trusts session_variables.x-hasura-user-id
# in the request body as the caller's identity — Hasura derives it from a verified
# JWT and nothing downstream re-checks it. Anything that can open a socket to the
# functions port can therefore POST {"session_variables":{"x-hasura-user-id":
# "<any victim>"}} and export, mutate, or delete that user's account.
#
# Hasura attaches this value as the x-nself-webhook-secret header on every action,
# event-trigger, and cron-trigger call (hasura/metadata/{actions,event_triggers,
# cron_triggers}.yaml). functions/server.ts compares it in constant time and
# answers 401 on a mismatch. It MUST be identical on the hasura and functions
# services, and it is NOT the Hasura admin secret — use a separate value.
#
# Leaving it empty disables the check (the server logs a loud boot warning) so an
# existing deployment does not go dark on upgrade. Set it everywhere.
# Generate with: openssl rand -hex 32
NHOST_WEBHOOK_SECRET=replace-me-with-openssl-rand-hex-32

# =============================================================================
# Observability (K-S1-T03)
# =============================================================================
# Backend Sentry DSN — separate project from frontend DSN (never mix)
# Get from https://sentry.io → Projects → ntask-backend → Settings → Client Keys
# Leave blank to disable Sentry (errors logged locally only)
SENTRY_DSN_BACKEND=

# Push notification credentials (K-AUX-07 / A-S4-T2)
# FCM server key for Android push notifications
FCM_SERVER_KEY=
# APNs Team ID, Key ID, and private key path for iOS push
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_PATH=

# =============================================================================
# Backup & Disaster Recovery (K-S3-T06, K-S3-T07)
# =============================================================================
# Cloudflare R2 (S3-compatible) — preferred for zero egress fees
# Endpoint format: https://<account-id>.r2.cloudflarestorage.com
# Create bucket via Cloudflare dashboard: https://dash.cloudflare.com → R2
# Required by: make backup-remote, make restore-remote, make list-backups, make dr-test
BACKUP_S3_BUCKET=ntask-backups
BACKUP_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
BACKUP_ACCESS_KEY="<r2-access-key-id>"
BACKUP_SECRET_KEY="<r2-secret-access-key>"
BACKUP_S3_PREFIX=ntask
BACKUP_RETENTION_DAYS=30

# DR test database URL (scratch DB only — NEVER prod)
# Used by: make dr-test
DR_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ntask_dr_test

# ── Transactional email ──────────────────────────────────────────────────────
# Postmark, over SMTP. Postmark does not append anything to the message body,
# which is the reason we left Elastic Email: a shared/parent ESP account controls
# the compliance footer and unsubscribe link, it cannot be overridden per
# sub-account, and it therefore lands on password-reset mail.
#
# Use the SMTP endpoint, NOT the Postmark API. Setting AUTH_SMTP_HOST to the
# literal string "postmark" switches hasura-auth into API mode, where it renders
# server-side Postmark templates looked up by alias ("en.password-reset") and
# ignores AUTH_EMAIL_TEMPLATES_PATH. That fails with ErrorCode 1101 until those
# templates exist in Postmark's console, and it moves the templates out of git.
# SMTP mode keeps them in backend/email-templates/ where they are reviewable.
#
# On Postmark SMTP the username and the password are both the server token.
# LOCAL DEFAULT: the mailhog container from docker-compose.override.yml. Every
# message a local stack sends lands in its web inbox at http://localhost:8025 and
# leaves the machine never.
#
# These used to ship pointing at Postmark with the literal placeholder
# "<postmark server token>" for both user and password, so the first invite a
# self-hoster sent opened a connection to smtp.postmarkapp.com and came back
# "535 authentication failed" — a confusing failure against someone else's
# production mail provider (found by the 2026-08-24 fork drill).
AUTH_SMTP_HOST=mailhog
AUTH_SMTP_PORT=1025
AUTH_SMTP_SECURE=false
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_SENDER=no-reply@task.local.nself.org

# PRODUCTION: uncomment and fill in, replacing the local defaults above.
#AUTH_SMTP_HOST=smtp.postmarkapp.com
#AUTH_SMTP_PORT=587
#AUTH_SMTP_SECURE=false          # 587 is STARTTLS, not implicit TLS
#AUTH_SMTP_AUTH_METHOD=PLAIN
#AUTH_SMTP_USER=<postmark server token>
#AUTH_SMTP_PASS=<postmark server token>
#AUTH_SMTP_SENDER=noreply@nself.org

# Templates are rendered from this path as {locale}/{template-id}/{body.html,subject.txt}.
# Substitution is fasttemplate syntax — ${link}, ${email} — NOT Go template syntax.
AUTH_EMAIL_TEMPLATES_PATH=/app/email-templates
