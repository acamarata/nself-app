# apps/mobile/.env.example
# Copy to .env.local before running: cp .env.example .env.local
# .env.local is gitignored — never commit it.

# =============================================================================
# Backend URL
# =============================================================================
# Optional build-time default. Users can also set the backend URL at first login.
# Leave blank to require manual entry at first login.
# On a real device, use the host machine's LAN IP (not localhost):
#   EXPO_PUBLIC_DEFAULT_SERVER_URL=http://192.168.1.x:8080
EXPO_PUBLIC_DEFAULT_SERVER_URL=http://localhost:8080

# =============================================================================
# App metadata
# =============================================================================
# Environment name (development | staging | production)
APP_ENV=development

# App version shown in Sentry releases and crash reports
EXPO_PUBLIC_APP_VERSION=1.1.4

# =============================================================================
# Sentry (optional — leave blank to disable error reporting)
# =============================================================================
EXPO_PUBLIC_SENTRY_DSN=

# =============================================================================
# Observability / OpenTelemetry (optional — leave blank to disable)
# =============================================================================
EXPO_PUBLIC_OTEL_ENDPOINT=

# =============================================================================
# EAS / Expo (required for OTA updates and production builds)
# =============================================================================
# Find your project ID in the Expo dashboard: https://expo.dev/accounts/
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
