{
  "name": "ntask-mobile",
  "version": "1.1.4",
  "description": "ɳTask — self-hosted task management app powered by nSelf",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
