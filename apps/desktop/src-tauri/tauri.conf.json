{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "\u0273Task",
  "identifier": "org.nself.ntask",
  "version": "1.2.0",
  "build": {
    "frontendDist": "../../../../web/ntask/dist",
    "devUrl": "http://localhost:3017",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "\u0273Task",
        "url": "https://task.nself.org",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true
      },
      {
        "label": "settings",
        "title": "\u0273Task Settings",
        "url": "/settings",
        "width": 800,
        "height": 600,
        "visible": false,
        "resizable": true,
        "decorations": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' tauri: ipc: http://localhost:* ws://localhost:* https://api.ntask.nself.org wss://api.ntask.nself.org https://*.nself.org https://task.nself.org https://api.task.nself.org wss://api.task.nself.org https://auth.task.nself.org; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob:"
    }
  },
  "plugins": {
    "window-state": null,
    "autostart": null,
    "updater": {
      "endpoints": [
        "https://packages.nself.org/desktop/ntask/latest-{{target}}.json"
      ],
      "pubkey": "PLACEHOLDER_REPLACE_WITH_LITERAL_BASE64_FROM_ntask.pub_SEE_PROC-3",
      "dialog": true
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "ntask"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/tray-connected.png": "icons/tray-connected.png",
      "icons/tray-syncing.png": "icons/tray-syncing.png",
      "icons/tray-offline.png": "icons/tray-offline.png"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "$APPLE_SIGNING_IDENTITY",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {},
      "nsis": {}
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
