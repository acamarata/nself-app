{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ɳTask",
  "identifier": "org.nself.ntask",
  "version": "1.4.0",
  "build": {
    "frontendDist": "../../../../web/ntask/dist",
    "devUrl": "http://localhost:3017",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ɳTask",
        "url": "https://task.nself.org/welcome?app=desktop",
        "width": 1100,
        "height": 760,
        "minWidth": 400,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' tauri: ipc: http://localhost:* ws://localhost:* https://api.ntask.nself.org wss://api.ntask.nself.org https://*.nself.org https://task.nself.org https://api.task.nself.org wss://api.task.nself.org https://auth.task.nself.org https://analytics.nself.org https://*.sentry.io; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob:"
    }
  },
  "plugins": {
    "window-state": null,
    "autostart": null,
    "updater": {
      "_comment": "Filename scheme is latest-{{target}}.json (no 'ntask-' prefix \u2014 the /desktop/ntask/ path segment already namespaces it). .github/workflows/publish-updater.yml MUST write manifests under this exact scheme or the updater 404s.",
      "endpoints": [
        "https://packages.nself.org/desktop/ntask/latest-{{target}}.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgMDRCRDY0OEMxNDMxMUJDNwpSV1RIR3pFVWpHUzlCQVFLL3FyVHAzeEwwdFM5UFM4OTdBNjlLNEJPK080cGt2WUN5NksrVEppUAo=",
      "dialog": true
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "ntask"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/tray-connected.png": "icons/tray-connected.png",
      "icons/tray-syncing.png": "icons/tray-syncing.png",
      "icons/tray-offline.png": "icons/tray-offline.png"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "$APPLE_SIGNING_IDENTITY",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {},
      "nsis": {}
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
