###############################################################################
# ɳTask CLI Environment Variables
#
# Copy this file to .env and customize, or export these directly in your shell.
# All vars are optional — the CLI falls back to the 'local' endpoint preset
# and stored credentials (~/.config/ntask/credentials.json) if unset.
#
# See cli/README.md § Environment Variables for full behavior and priority
# order (flags > env vars > stored profile > 'local' default).
###############################################################################

# GraphQL endpoint override. Takes priority over the resolved profile preset.
# Local:      http://localhost:8080/v1/graphql
# Staging:    https://api.task.staging.nself.org/v1/graphql
# Production: https://api.task.nself.org/v1/graphql
NTASK_API_URL=http://localhost:8080/v1/graphql

# Auth endpoint override. Takes priority over the resolved profile preset.
# Local:      http://localhost:4000
# Staging:    https://auth.task.staging.nself.org
# Production: https://auth.task.nself.org
NTASK_AUTH_URL=http://localhost:4000

# Named endpoint preset: local | staging | prod (see cli/src/lib/config.ts
# PROFILE_PRESETS). Shorthand for setting both URLs above at once.
NTASK_ENDPOINT=local

# Bearer token to use directly, skipping login and stored credentials.
# CHANGE: Never commit a real token — source from ~/.claude/vault.env or a
# CI secret store.
NTASK_TOKEN=

# Email + password for non-interactive login (e.g. CI or scripts). Both must
# be set together — the CLI does not partially authenticate.
NTASK_EMAIL=
NTASK_PASSWORD=

# Named profile to read from stored credentials
# (~/.config/ntask/credentials.json), if not using NTASK_TOKEN or
# NTASK_EMAIL/NTASK_PASSWORD directly.
NTASK_PROFILE=
