{
  "name": "@nself/ntask-cli",
  "version": "0.1.0",
  "description": "ɳTask CLI \u2014 manage tasks and lists from the terminal or an AI agent",
  "type": "module",
  "bin": {
    "ntask": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./lib/*": "./dist/lib/*.js",
    "./gql": "./dist/gql.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci:local": "pnpm typecheck && pnpm build && pnpm test"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "nSelf",
  "homepage": "https://github.com/nself-org/ntask/tree/main/apps/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nself-org/ntask.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/nself-org/ntask/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ntask",
    "nself",
    "tasks",
    "todo",
    "cli",
    "graphql",
    "hasura"
  ]
}
