# ɳTask TV — environment variables template
# Copy to .env.dev for local development (never commit .env.dev)

# nSelf backend URL (required — set via ConnectScreen on first launch)
EXPO_PUBLIC_SERVER_URL=

# Optional: Sentry DSN for crash reporting
EXPO_PUBLIC_SENTRY_DSN=

# Build environment (development | staging | production)
APP_ENV=development

# App version — auto-set from package.json version at build time
EXPO_PUBLIC_APP_VERSION=1.1.4
