{
  "name": "ntask-tv",
  "version": "1.4.0",
  "description": "ɳTask TV \u2014 read-focused glanceable dashboard for Apple TV and Android TV",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --ios",
    "tvos": "expo start --ios",
    "android-tv": "expo start --android",
    "test": "jest --config jest.config.js --passWithNoTests",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "ci:local": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@nself/i18n": "workspace:*",
    "@nself/ntask-core": "workspace:*",
    "@nself/offline-queue": "workspace:*",
    "@nself/auth-core": "workspace:*",
    "@nself/errors": "workspace:*",
    "@nself/graphql-client": "workspace:*",
    "@nself/sdk-core": "workspace:*",
    "@nself/types": "workspace:*",
    "expo-localization": "~17.0.9",
    "i18next": "^23.7.6",
    "react-i18next": "^15.1.0",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@urql/core": "^5.0.6",
    "expo": "~53.0.0",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.2.1",
    "graphql": "^16.8.1",
    "react": "19.0.0",
    "react-native": "npm:react-native-tvos@^0.79.2-0",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "3.35.0",
    "urql": "^4.2.1",
    "wonka": "^6.3.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.0",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "overrides": {
      "react-native": "npm:react-native-tvos@^0.79.2-0"
    }
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.{ts,tsx}",
      "**/*.test.{ts,tsx}"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native(-tvos)?|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg))"
    ],
    "setupFilesAfterFramework": [
      "@testing-library/jest-native/extend-expect"
    ]
  }
}
