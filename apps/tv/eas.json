{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium",
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "tvos": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "IS_TV": "1"
      }
    },
    "android-tvos": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "IS_TV": "1"
      }
    },
    "production-tvos": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production-android-tv": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production-tvos": {
      "ios": {
        "appleId": "nself@example.com",
        "ascAppId": "org.nself.ntask.tv",
        "appleTeamId": "NSELF_TEAM_ID"
      }
    },
    "production-android-tv": {
      "android": {
        "serviceAccountKeyPath": "./google-services-key.json",
        "track": "production"
      }
    }
  }
}
