{
  "name": "ntask",
  "version": "1.3.1",
  "description": "task.nself.org - ɳTask free task management app",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-sport.mjs",
    "dev": "vite --port 3017",
    "prebuild": "node scripts/sync-sport.mjs --check",
    "build": "vite build",
    "postbuild": "[ -n \"$SENTRY_AUTH_TOKEN\" ] && sentry-cli sourcemaps inject --org nself --project web-ntask ./dist && sentry-cli sourcemaps upload --org nself --project web-ntask ./dist || true",
    "start": "vite preview --port 3017",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "node scripts/coverage-sharded.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@nself-web/csp": "workspace:*",
    "@nself-web/og": "workspace:*",
    "@nself-web/ui": "workspace:*",
    "@nself/auth-core": "workspace:*",
    "@nself/graphql-client": "workspace:*",
    "@nself/i18n": "workspace:*",
    "@nself/ntask-core": "workspace:*",
    "@nself/observability": "workspace:*",
    "@nself/offline-queue": "workspace:*",
    "@nself/tailwind-brand": "workspace:*",
    "@sentry/react": "^8",
    "@tailwindcss/postcss": "^4.2.1",
    "@tauri-apps/api": "^2",
    "@vercel/og": "1.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "graphql": "^16.13.1",
    "graphql-ws": "^6.0.7",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.2",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/node": "^5.8.22",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-istanbul": "^3.2.6",
    "eslint": "^9.32.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.6",
    "workbox-window": "^7.3.0"
  }
}
