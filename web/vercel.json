{
  "ignoreCommand": "bash -c 'if [ \"$VERCEL_ENV\" = preview ]; then exit 0; fi; exit 1'",
  "framework": "vite",
  "installCommand": "bash scripts/vercel-install.sh",
  "outputDirectory": "dist",
  "buildCommand": "bash scripts/vercel-build.sh",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|@|\\.well-known/|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://analytics.nself.org; style-src 'self' 'unsafe-inline'; connect-src 'self' ws: wss: https://api.task.nself.org wss://api.task.nself.org https://api.task.staging.nself.org wss://api.task.staging.nself.org https://auth.task.nself.org https://auth.task.staging.nself.org https://auth.nself.org https://auth.staging.nself.org https://*.sentry.io https://analytics.nself.org; img-src 'self' data: https:; font-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/aup",
      "destination": "/legal/aup",
      "permanent": true
    },
    {
      "source": "/cookies",
      "destination": "/legal/cookies",
      "permanent": true
    },
    {
      "source": "/help/faq",
      "destination": "/help#faq",
      "permanent": true
    },
    {
      "source": "/help/create-task",
      "destination": "/help#create-task",
      "permanent": true
    },
    {
      "source": "/help/lists",
      "destination": "/help#lists",
      "permanent": true
    },
    {
      "source": "/help/offline-mode",
      "destination": "/help#offline-mode",
      "permanent": true
    },
    {
      "source": "/help/troubleshooting-sync",
      "destination": "/help#troubleshooting-sync",
      "permanent": true
    },
    {
      "source": "/help/getting-started-web",
      "destination": "/help#getting-started-web",
      "permanent": true
    },
    {
      "source": "/help/getting-started-ios",
      "destination": "/help#getting-started-ios",
      "permanent": true
    },
    {
      "source": "/help/getting-started-self-host",
      "destination": "/help#getting-started-self-host",
      "permanent": true
    },
    {
      "source": "/help/docker-quickstart",
      "destination": "/help#getting-started-self-host",
      "permanent": true
    },
    {
      "source": "/open-source",
      "destination": "https://github.com/nself-org/ntask",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "https://nself.org/task",
      "permanent": true
    },
    {
      "source": "/download",
      "destination": "https://github.com/nself-org/ntask/releases",
      "permanent": true
    },
    {
      "source": "/download/:path*",
      "destination": "https://github.com/nself-org/ntask/releases",
      "permanent": true
    },
    {
      "source": "/changelog",
      "destination": "https://github.com/nself-org/ntask/releases",
      "permanent": true
    },
    {
      "source": "/changelog/:path*",
      "destination": "https://github.com/nself-org/ntask/releases",
      "permanent": true
    },
    {
      "source": "/compare",
      "destination": "https://nself.org/task",
      "permanent": true
    },
    {
      "source": "/compare/:path*",
      "destination": "https://nself.org/task",
      "permanent": true
    },
    {
      "source": "/features",
      "destination": "https://nself.org/task",
      "permanent": true
    },
    {
      "source": "/features/:path*",
      "destination": "https://nself.org/task",
      "permanent": true
    },
    {
      "source": "/self-host",
      "destination": "https://nself.org/docs/guides/ntask-self-hosting",
      "permanent": true
    },
    {
      "source": "/self-host/:path*",
      "destination": "https://nself.org/docs/guides/ntask-self-hosting",
      "permanent": true
    }
  ]
}
