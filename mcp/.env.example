###############################################################################
# ɳTask MCP Server Environment Variables
#
# Copy this file to .env and customize, or set these in your MCP client's
# server config (see mcp/README.md § Client configuration for
# claude_desktop_config.json / .mcp.json / .cursor/mcp.json examples).
#
# Auth is resolved once at process start, in priority order:
#   1. NTASK_TOKEN
#   2. NTASK_EMAIL + NTASK_PASSWORD (login-on-start)
#   3. Stored CLI credentials (~/.config/ntask/credentials.json), via NTASK_PROFILE
# If none resolve, every tool call fails with an actionable error.
#
# See mcp/README.md § Environment variables for full details.
###############################################################################

# GraphQL endpoint. Default: http://localhost:8080/v1/graphql
NTASK_API_URL=http://localhost:8080/v1/graphql

# Auth endpoint. Default: http://localhost:4000
NTASK_AUTH_URL=http://localhost:4000

# Named endpoint preset: local | staging | prod. Shorthand for the two URLs
# above (see @nself/ntask-cli's config.ts PROFILE_PRESETS).
NTASK_ENDPOINT=local

# Bearer token — use this directly, skipping login. Highest auth priority.
# CHANGE: Never commit a real token — source from ~/.claude/vault.env or a
# CI/MCP-client secret store.
NTASK_TOKEN=

# Login-on-start credentials. Both must be set together; the server will not
# attempt auth with only one of the pair set.
NTASK_EMAIL=
NTASK_PASSWORD=

# Named CLI credentials profile to read, if using stored credentials instead
# of NTASK_TOKEN or NTASK_EMAIL/NTASK_PASSWORD.
NTASK_PROFILE=
